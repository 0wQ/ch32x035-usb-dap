settings set target.language c

breakpoint set -n pWriteData
breakpoint command add 1
expression -- (void)printf("\\nMRS PROBE TRACE pWriteData\\n")
register read x0 x1 x2 x3
memory read --format x --size 1 --count 64 $x2
continue
DONE

breakpoint set -n pReadData
breakpoint command add 2
expression -- (void)printf("\\nMRS PROBE TRACE pReadData\\n")
register read x0 x1 x2 x3
memory read --format x --size 1 --count 64 $x2
continue
DONE

run
